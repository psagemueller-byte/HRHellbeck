# ===========================================
# Hellbeck HR Portal — Environment Variables
# ===========================================
# Kopiere diese Datei zu .env.local und fülle die Werte aus.

# -------------------------------------------
# Auth.js (NextAuth v5)
# -------------------------------------------
# Generiere mit: npx auth secret
AUTH_SECRET=

# URL der App (lokal: http://localhost:3000, Produktion: https://hr.hellbeck.de)
AUTH_URL=http://localhost:3000

# -------------------------------------------
# Datenbank (PostgreSQL / Vercel Postgres)
# -------------------------------------------
# Vercel Postgres: Dashboard → Storage → Postgres → .env.local Tab
DATABASE_URL=
# Direkte Verbindung (ohne Pooling) — nur für Prisma Migrationen
DIRECT_URL=

# -------------------------------------------
# E-Mail (Resend)
# -------------------------------------------
# API-Key von: https://resend.com/api-keys
RESEND_API_KEY=
# Absender-Adresse (Domain muss in Resend verifiziert sein)
EMAIL_FROM=HR Portal <noreply@hellbeck.de>

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# Auf "true" setzen für Entwicklung ohne Datenbank (nutzt Mock-Daten)
NEXT_PUBLIC_MOCK_AUTH=true

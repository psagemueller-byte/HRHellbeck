# ===========================================
# Hellbeck HR Portal — Environment Variables
# ===========================================
# Kopiere diese Datei zu .env.local und fülle die Werte aus.

# -------------------------------------------
# Auth.js (NextAuth v5)
# -------------------------------------------
# Generiere mit: npx auth secret
AUTH_SECRET=

# URL der App (lokal: http://localhost:3000, Produktion: https://hr.hellbeck.de)
AUTH_URL=http://localhost:3000

# -------------------------------------------
# Datenbank (PostgreSQL / Supabase)
# -------------------------------------------
# Supabase Dashboard → Settings → Database → Connection string
#
# Format für Supavisor Pooler (neues Format):
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
#
# Wichtig: Passwort muss URL-encoded sein (z.B. [ → %5B, ] → %5D, * → %2A, $ → %24)
# Wichtig: DATABASE_URL (Port 6543) braucht ?pgbouncer=true für Prisma
# Wichtig: DIRECT_URL (Port 5432) wird für Prisma Migrationen verwendet
DATABASE_URL=
DIRECT_URL=

# -------------------------------------------
# E-Mail (Resend)
# -------------------------------------------
# API-Key von: https://resend.com/api-keys
RESEND_API_KEY=
# Absender-Adresse (Standard: onboarding@resend.dev, oder eigene verifizierte Domain)
EMAIL_FROM=Hellbeck HR Portal <onboarding@resend.dev>

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# Auf "true" setzen für Entwicklung ohne Datenbank (nutzt Mock-Daten)
NEXT_PUBLIC_MOCK_AUTH=true

# ===========================================
# Hellbeck HR Portal — Environment Variables
# ===========================================
# Kopiere diese Datei zu .env.local und fülle die Werte aus.

# -------------------------------------------
# Auth.js (NextAuth v5)
# -------------------------------------------
# Generiere mit: npx auth secret
AUTH_SECRET=

# URL der App (lokal: http://localhost:3000, Produktion: https://hr.hellbeck.de)
AUTH_URL=http://localhost:3000

# -------------------------------------------
# Datenbank (PostgreSQL / Vercel Postgres)
# -------------------------------------------
# Vercel Postgres: Dashboard → Storage → Postgres → .env.local Tab
DATABASE_URL=
# Direkte Verbindung (ohne Pooling) — nur für Prisma Migrationen
DIRECT_URL=

# -------------------------------------------
# E-Mail (Resend)
# -------------------------------------------
# API-Key von: https://resend.com/api-keys
RESEND_API_KEY=
# Absender-Adresse (Standard: onboarding@resend.dev, oder eigene verifizierte Domain)
EMAIL_FROM=Hellbeck HR Portal <onboarding@resend.dev>

# -------------------------------------------
# Supabase (Datenbank + Storage)
# -------------------------------------------
# Supabase-Projekt-URL (Dashboard → Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase Anon/Public Key (Dashboard → Settings → API → anon/public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase Service Role Key (Dashboard → Settings → API → service_role)
# NUR serverseitig verwenden — NIEMALS im Client exponieren!
SUPABASE_SERVICE_ROLE_KEY=

# -------------------------------------------
# Feature Flags
# -------------------------------------------
# Auf "true" setzen für Entwicklung ohne Datenbank (nutzt Mock-Daten)
NEXT_PUBLIC_MOCK_AUTH=true

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// Auth.js required models
// ============================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Application User model (extends Auth.js User)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?

  // Password (null for OAuth-only users)
  passwordHash String?

  // HR-specific fields
  firstName         String  @default("")
  lastName          String  @default("")
  position          String  @default("")
  department        String  @default("Ohne Abteilung")
  role              String  @default("benutzer")
  phone             String  @default("")
  street            String  @default("")
  city              String  @default("")
  zipCode           String  @default("")
  country           String  @default("Deutschland")
  birthDate         String  @default("")
  startDate         String  @default("")
  managerId         String?
  isActive          Boolean @default(true)
  totalVacationDays Int     @default(30)

  // Relations
  accounts            Account[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  vacationRequests    VacationRequest[]
  shiftEntries        ShiftEntry[]        @relation("ShiftUser")
  shiftsCreated       ShiftEntry[]        @relation("ShiftCreator")
  newsArticles        NewsArticle[]
  sentMessages        ChatMessage[]       @relation("MessageSender")
  receivedMessages    ChatMessage[]       @relation("MessageReceiver")
  disruptionReports   DisruptionReport[]  @relation("DisruptionReporter")
  assignedDisruptions DisruptionReport[]  @relation("DisruptionAssignee")
  handoverProtocols   HandoverProtocol[]
  vacationCancelReqs  VacationCancelRequest[]
}

// ============================================
// Departments (Org Chart)
// ============================================

model Department {
  id     String @id @default(cuid())
  name   String @unique
  headId String @default("")
  color  String @default("bg-gray-100 text-gray-700 border-gray-200")
}

// ============================================
// Password Reset Token
// ============================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Vacation Requests
// ============================================

model VacationRequest {
  id         String   @id @default(cuid())
  userId     String
  startDate  String
  endDate    String
  days       Int
  type       String   @default("urlaub") // urlaub, sonderurlaub, unbezahlt
  status     String   @default("ausstehend") // ausstehend, genehmigt, abgelehnt
  reason     String?
  approvedBy String?
  approvedAt String?
  createdAt  DateTime @default(now())

  user          User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  cancelRequest VacationCancelRequest[]
}

// ============================================
// Vacation Cancel Requests
// ============================================

model VacationCancelRequest {
  id          String   @id @default(cuid())
  vacationId  String
  userId      String
  reason      String
  cancelDates String[] @default([]) // specific dates for partial cancellation
  status      String   @default("ausstehend") // ausstehend, genehmigt, abgelehnt
  decidedBy   String?
  decidedAt   String?
  createdAt   DateTime @default(now())

  vacation VacationRequest @relation(fields: [vacationId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Shift Entries (Personalplanung)
// ============================================

model ShiftEntry {
  id        String  @id @default(cuid())
  userId    String
  date      String
  type      String  // frueh, spaet, nacht, frei, feiertag, urlaub, sonderurlaub, krank
  startTime String?
  endTime   String?
  note      String?
  createdBy String

  user    User @relation("ShiftUser", fields: [userId], references: [id], onDelete: Cascade)
  creator User @relation("ShiftCreator", fields: [createdBy], references: [id], onDelete: Cascade)
}

// ============================================
// News Articles
// ============================================

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  excerpt     String
  content     String   @db.Text
  author      String
  authorId    String
  category    String   // unternehmen, team, event, hr
  imageUrl    String?  @db.Text
  likes       String[] @default([])
  readBy      String[] @default([])
  publishedAt DateTime @default(now())

  authorUser User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ============================================
// Chat Messages
// ============================================

model ChatMessage {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  timestamp  DateTime @default(now())

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
}

// ============================================
// Disruption Reports
// ============================================

model DisruptionReport {
  id          String   @id @default(cuid())
  reporterId  String
  category    String   // maschinenstillstand, materialfehler, etc.
  title       String
  description String   @db.Text
  location    String?
  imageUrls   String[] @default([])
  status      String   @default("offen") // offen, in_bearbeitung, erledigt
  assignedTo  String?
  createdAt   DateTime @default(now())

  reporter User  @relation("DisruptionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  assignee User? @relation("DisruptionAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
}

// ============================================
// Handover Protocols
// ============================================

model HandoverProtocol {
  id            String   @id @default(cuid())
  authorId      String
  shiftDate     String
  shiftType     String
  machineStatus String   @db.Text
  openTasks     String   @db.Text
  incidents     String   @db.Text
  notes         String   @db.Text
  createdAt     DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}
